<!-- Example -->
<group name="local,syslog,ufw,">

  <rule id="100100" level="5">
    <location>/var/log/ufw.log</location>
    <match>UFW BLOCK</match>
    <description>UFW firewall event detected</description>
    <group>firewall,</group>
  </rule>

  <rule id="100101" level="10" frequency="8" timeframe="20">
    <if_matched_sid>100100</if_matched_sid>
    <description>Possible port scan detected: multiple UFW blocks in a short window</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,attack,</group>
  </rule>

</group>
